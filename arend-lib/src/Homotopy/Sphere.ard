-- The file defines a function `Sphere`, constructing spheres via suspension, and a `pointed` function creating pointed types for spheres.
\import Function.Iterate
\import Homotopy.Pointed
\import Homotopy.Suspension
\import Logic

\func Sphere (n : Nat) => Susp (iterr Susp n Empty)
  \where
    \func pointed (n : Nat) => \new Pointed (Sphere n) north
