\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Arith.Int
\import Arith.Nat
\import Arith.Nat.Sequence
\import Function.Meta
\import Logic.Unique
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin.Pigeonhole

-- Existence of a positive finite order for an element in a group with a pigeonhole structure.
-- Using the pigeonhole principle on the sequence of powers `1, g, g^2, ...`,
-- there exist indices i < j such that g^i = g^j, hence g^{j−i} = 1 with j−i > 0.
\lemma hasFiniteOrder {G : Group} {P : PigeonholeSet G} (g : G) : ∃ (n : Nat) (n > 0) (G.pow g n = 1)
  => {?}

-- The (positive) order of an element `g`: the least positive n with `g^n = 1`.
-- Requires a pigeonhole structure to ensure existence and a decidable set to choose the least one.
\sfunc order {G : Group} {P : PigeonholeSet G} {D : DecSet G} (g : G) : Nat
  => (aux g).1
  \where {
    -- Auxiliary construction producing:
    -- 1) a witness `n`;
    -- 2) a proof that `n > 0` and `g^n = 1`;
    -- 3) minimality of `n` among all positive exponents with `g^m = 1`.
    \func aux {G : Group} {P : PigeonholeSet G} {D : DecSet G} (g : G)
      : \Sigma (n : Nat) (\Sigma (n > 0) (G.pow g n = 1)) (\Pi (m : Nat) -> (\Sigma (m > 0) (G.pow g m = 1)) -> n <= m)
      => {?}
  }

-- The order is strictly positive by construction.
\lemma order>0 {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} : order g > 0
  => {?}

-- The defining property of order: `g^(order g) = 1`.
\lemma order_pow {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} : G.pow g (order g) = 1
  => {?}

-- Minimality of order: for any positive `m` with `g^m = 1`, we have `order g <= m`.
\lemma order-min {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {m : Nat} (p : m > 0) (q : G.pow g m = 1) : order g <= m
  => {?}
