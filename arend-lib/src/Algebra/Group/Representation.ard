\import Algebra.Group
\import Algebra.Group.GSet.ExampleActions
\import Algebra.Group.GSet
\import Algebra.Module
\import Algebra.Module.LinearMap
\import Algebra.Pointed
\import Algebra.Ring
\import Meta
\import Paths
\import Paths.Meta

-- basic reference right now is https://www.uni-math.gwdg.de/tammo/rep.pdf
-- REPRESENTATION THEORY Tammo tom Dieck
-- also : https://www.maths.dur.ac.uk/users/jack.g.shotton/repthy/index.html

-- | A linear representation of a group {G} on a module {E} over a ring {R}.
--   It extends both {LModule} and {GroupAction}, adding the requirement that group elements act as linear maps.
\class LinRepres \extends LModule, GroupAction {
  -- | The action of a group element distributes over addition in the module.
  | **-ldistr {g :  G} {e e' : E} : g ** (e + e') = g ** e + g ** e'
  -- | The action of a group element commutes with scalar multiplication.
  | **-*c {g :  G} {e : E} {c : R} : g ** (c *c e) = c *c (g ** e)

  -- | Group elements act on the zero element of the module to give zero.
  \lemma g**-zro {g : G} : g ** 0 = 0 => {?}

  -- | Group elements act on the negative of an element to give the negative of the result.
  \lemma g**-negative {g : G} {e : E} : g ** negative e = negative (g ** e) => {?}

  -- | Converts a group element into its corresponding linear map on the module.
  \func toLinearMap(g : G) : LinearMap \this \this \cowith
    | func e => g ** e
    | func-+ => **-ldistr
    | func-*c => **-*c

  -- | The identity element of the group corresponds to the identity linear map.
  \lemma toLinearMap-ide : toLinearMap ide = LinearMap.id
    => {?}
}

-- | Constructs a trivial representation of a group {G} on a module {E}.
--   Every group element acts as the identity map.
\func TrivialAction {R : Ring} (E : LModule R) (G : Group) : LinRepres R G \cowith
  | LModule => E
  | GroupAction => trivialAction G E
  | **-*c => idp
  | **-ldistr => idp

-- | A type alias for {LinRepres} with explicit ring and group parameters.
\func LRepres (R : Ring)(G : Group) : \Type => {?}
