\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Monoid.Sub
\import Algebra.Pointed
\import Function
\import Function.Meta
\import Logic
\import Meta
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Relation.Equivalence
\import Set
\import Set.Fin
\import Set.Fin.Instances
\import Set.SetHom
\open Group \hiding (Dec)

-- | A subgroup of a group G is a subset of G that is a submonoid and is closed under the inverse operation.
\class SubGroup \extends SubMonoid {
  \override S : Group
  -- | A subgroup is closed under the inverse operation.
  | contains_inverse {x : S} : contains x -> contains (inverse x)

  -- | The subgroup itself as a group.
  \func IGroup : Group \cowith
    | Monoid => IMonoid
    | inverse x => {?}
    | inverse-left => {?}
    | inverse-right => {?}

  -- | The equivalence relation defined by a subgroup: x ~ y iff x^-1 * y is in the subgroup.
  \func equivalence : Equivalence S \cowith
    | ~ x y => contains (inverse x * y)
    | ~-reflexive => transportInv contains inverse-left contains_ide
    | ~-symmetric c => transport contains (inverse_* *> pmap (_ *) inverse-isInv) (contains_inverse c)
    | ~-transitive {x} {y} c1 c2 => rewriteEq (inverse-right {S} {y}, ide-left) in contains_* c1 c2

  -- | The set of left cosets of a subgroup.
  \func Cosets => Quotient (equivalence.~)

  -- | If an element belongs to the subgroup, it is equivalent to the identity.
  \lemma contains->equiv {x : S} (p : contains x) : 1 equivalence.~ x => {?}

  -- | If an element is equivalent to the identity, it belongs to the subgroup.
  \lemma equiv->contains {x : S}(p : 1 equivalence.~ x) : contains x =>
    {?}
    \where
      \func helper {x : S} : inverse ide * x = x
        => {?}

  -- | The equivalence relation is invariant under right multiplication by elements of the subgroup.
  \lemma invariant-right-multiplication {x y : S} (p : 1 equivalence.~ y)
    : in~{S} {equivalence.~} x = in~ {S} {equivalence.~} (x * y)
    => {?}
    \where{
      \func helper : inverse x * x * y = y => {?}

      \func contains-x^-1*x*y : contains (inverse x * x * y) => {?}
    }

  -- | If x ~ y, then 1 ~ x^-1 * y.
  \lemma equivalence-to-1 {x y : S} (p : x equivalence.~ y) : 1 equivalence.~ inverse x * y => {?}
--  \lemma equivalence-reverse {x y : S} (p : 1 equivalence.~ inverse x * y) : x equivalence.~ y

} \where {
  -- | A subgroup of a commutative group is also a commutative group.
  \func cStruct {G : CGroup} (S : SubGroup G) : CGroup \cowith
    | Group => S.IGroup
    | *-comm => {?}
}

-- | A subgroup with a decidable membership.
\class DecSubGroup \extends SubGroup, DecSubMonoid {
  \override S : Group
}

-- | Constructs a subgroup from a subset closed under x^-1 * y and containing the identity.
\func anotherSubgroupDefinition{G : Group} (X : SubSet G)
                               (p : \Pi (x y : G) -> X.contains x -> X.contains y -> X.contains (inverse x * y))
                               (q : X.contains ide) : SubGroup G {| contains => X.contains | contains_ide => q} \cowith
  | contains_* {x y : G} (r : X.contains x) (r' : X.contains y) : X.contains (x * y) => {?}
  | contains_inverse {g : G} (xi : X.contains g) : X.contains (inverse g) => {?}
  \where {
    \func helper (g : G) (r : X.contains g) : X.contains (inverse g * G.ide) => {?}

    \func inv (g : G) (r : X.contains g) : X.contains (inverse g) => {?}

    \func contains_*' {x y : G} (r : X.contains x) (r' : X.contains y) : X.contains (inverse (inverse x) * y) => {?}
  }



-- | Subgroups are ordered by inclusion.
\instance SubGroupPreorder {G : Group} : Preorder (SubGroup G)
  | <= (H K : SubGroup G) => \Pi (g : G) -> H.contains g -> K.contains g
  | <=-refl {H : SubGroup G} => \lam (g : G) (p : H.contains g) => p
  | <=-transitive {H K N : SubGroup G}
                  (p : \Pi (g : G) -> H.contains g -> K.contains g)
                  (q : \Pi (g : G) -> K.contains g -> N.contains g)
  => \lam (g : G) (r : H.contains g) => q g (p g r)

-- | If an element is in the kernel of the quotient map, then its image is the identity.
\func kernelEquivProp {G : Group} (N : NormalSubGroup G) (a : G) (p : N.contains a) : N.quotient.ide = in~ a => {?}
  \where
    \func help-condition : a N.equivalence.~ 1 => {?}

-- | A subgroup is normal if it is closed under conjugation.
\class NormalSubGroup \extends SubGroup {
  -- | A normal subgroup is closed under conjugation.
  | isNormal (g : S) {h : S} : contains h -> contains (conjugate g h)

  -- | Equivalent definition of normality: g^-1 * h * g is in the subgroup.
  \lemma isNormal' (g : S) {h : S} (c : contains h) : contains (inverse g * h * g)
    => simplify in isNormal (inverse g) c

  -- | The quotient group of a group by a normal subgroup.
  \func quotient : Group Cosets \cowith
    | ide => in~ 1
    | * (x y : Cosets) : Cosets \with {
      | in~ g, in~ g' => in~ (g Group.* g')
      | in~ g, ~-equiv x y r => {?}
      | ~-equiv x y r, in~ g => {?}
    }
    | ide-left {x} => {?}
    | ide-right {x} => {?}
    | *-assoc {x} {y} {z} => {?}
    | inverse (x : Cosets) : Cosets \with {
      | in~ g => in~ (Group.inverse g)
      | ~-equiv x y r => {?}
    }
    | inverse-left {x} => {?}
    | inverse-right {x} => cases x \with {
      | in~ a => pmap in~ inverse-right
    }

  -- | The canonical projection from a group to its quotient.
  \func quotient-proj-setwise : SetHom S quotient \cowith
    | func s => in~ s

  -- | An element is in the kernel of the quotient map iff it is in the normal subgroup.
  \func criterionForKernel (a : S) (p : contains a) : quotient.ide = in~ a => {?}
    \where
      \func help-condition : a equivalence.~ 1 => {?}

  -- | The canonical projection is surjective.
  \func quotIsSurj : IsSurj quotient-proj-setwise => {?}
}

-- | A subgroup of an additive group.
\class SubAddGroup \extends SubAddMonoid {
  \override S : AddGroup
  -- | An additive subgroup is closed under the negation.
  | contains_negative {x : S} : contains x -> contains (negative x)

  -- | An additive subgroup is closed under the subtraction.
  \lemma contains_- {x y : S} : contains x -> contains y -> contains (x - y)
    => \lam cx cy => contains_+ cx (contains_negative cy)

  -- | The subgroup as an additive group.
  \func IAddGroup : AddGroup \cowith
    | AddMonoid => IAddMonoid
    | negative x => {?}
    | negative-left => {?}
    | negative-right => {?}
} \where {
  -- | A subgroup of an abelian group is an abelian group.
  \func abStruct {A : AbGroup} (S : SubAddGroup A) : AbGroup \cowith
    | AddGroup => S.IAddGroup
    | +-comm => {?}

  -- | The maximal subgroup (containing all elements).
  \func max {A : AddGroup} : SubAddGroup \cowith
    | SubAddMonoid => SubAddMonoid.max {A}
    | contains_negative _ => ()
}

-- | A subgroup of a finite group.
\class FinSubGroup \extends DecSubGroup {
  \override S : FinGroup

  -- | The subgroup as a finite group.
  \func IFinGroup : FinGroup \cowith
    | Group => IGroup
    | FinSet => SigmaFin.DecSubSet-isFin S \this
}
