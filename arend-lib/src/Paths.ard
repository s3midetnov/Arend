-- | Heterogeneous equality.
--   This is a path in a universe of types.
--   Equivalent to 'path (\lam _ => a)'.
\func idpe {A : \Type} (a : A) : a = a => {?}

-- | Map a function over a path.
--   Also known as congruence.
\func pmap {A B : \Type} (f : A -> B) {a a' : A} (p : a = a') : f a = f a' => {?}

-- | Map a binary function over two paths.
\func pmap2 {A B C : \Type} (f : A -> B -> C) {a a' : A} (p : a = a') {b b' : B} (q : b = b') : f a b = f a' b'
  => {?}

-- | Transport a value along a path.
\func transport {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') (b : B a) : B a'
  => {?}

-- | Transport a value along the inverse of a path.
\func transportInv {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') (b : B a') : B a => {?}

-- | Transport a value along two paths.
\func transport2 {A B : \Type} (C : A -> B -> \Type) {a a' : A} {b b' : B} (p : a = a') (q : b = b') (c : C a b) : C a' b' => {?}

-- | Invert a path.
\func inv {A : \Type} {a a' : A} (p : a = a') : a' = a => {?}

-- | Concatenation of paths.
\func \infixr 9 *> {A : \Type} {a a' a'' : A} (p : a = a') (q : a' = a'') : a = a'' => {?}
  \where
    -- | Concatenation of a path and a path in a family of types.
    \func concat {A : I -> \Type} {a : A left} {a' a'' : A right} (p : Path A a a') (q : a' = a'') : Path A a a'' => {?}

-- | Concatenation of paths (alternative definition, matched on the first path).
\func \infixr 9 <* {A : \Type} {a a' a'' : A} (p : a = a') (q : a' = a'') : a = a'' => {?}
  \where
    -- | Concatenation of a path and a path in a family of types.
    \func concat {A : I -> \Type} {a a' : A left} {a'' : A right} (p : a = a') (q : Path A a' a'') : Path A a a'' => {?}

-- | Connection between path and its application.
\func psqueeze {A : \Type} {a a' : A} (p : a = a') (i : I) : a = p @ i => {?}

-- | Left path induction (J eliminator).
\func Jl {A : \Type} {a : A} (B : \Pi (a' : A) -> a = a' -> \Type) (b : B a idp) {a' : A} (p : a = a') : B a' p => {?}
  \where {
    -- | Right path induction (J eliminator).
    \func Jr {A : \Type} {a' : A} (B : \Pi (a : A) -> a = a' -> \Type) (b : B a' idp) {a : A} (p : a = a') : B a p => {?}

    -- | Alternative definition of J in terms of coe.
    -- | J can be defined in terms of coe
    \func def {A : \Type} {a : A} (B : \Pi (a' : A) -> a = a' -> \Type) (b : B a idp) {a' : A} (p : a = a') : B a' p => {?}
  }

-- | pmap commutes with path concatenation.
\func pmap_*>-comm {A B : \Type} (f : A -> B) {a a' a'' : A} (p : a = a') (q : a' = a'')
  : pmap f (p *> q) = pmap f p *> pmap f q => {?}

-- | pmap commutes with path concatenation (alternative definition).
\func pmap_<*-comm {A B : \Type} (f : A -> B) {a a' a'' : A} (p : a = a') (q : a' = a'')
  : pmap f (p <* q) = pmap f p <* pmap f q => {?}

-- | pmap2 commutes with path concatenation.
\func pmap2_*>-comm {A B C : \Type} (f : A -> B -> C) {a a' a'' : A} (p : a = a') (q : a' = a'') {b b' b'' : B} (s : b = b') (t : b' = b'')
  : pmap2 f (p *> q) (s *> t) = pmap2 f p s *> pmap2 f q t => {?}

-- | Inverse of an inverse is the original path.
\func inv_inv {A : \Type} {a a' : A} (p : a = a') : inv (inv p) = p => {?}

-- | Concatenation of a path with its inverse is idp.
\func inv_*> {A : \Type} {a a' : A} (p : a = a') : inv p *> p = idp => {?}

-- | Concatenation of a path with its inverse is idp.
\func *>_inv {A : \Type} {a a' : A} (p : a = a') : p *> inv p = idp => {?}

-- | idp is a left identity for path concatenation.
\func idp_*> {A : \Type} {a a' : A} (p : a = a') : idp *> p = p => {?}
  \where
    -- | idp is a left identity for concat.
    \func idp_concat {A : \Type} {a a' : A} (p : a = a') : *>.concat idp p = p => {?}

-- | idp is a right identity for path concatenation (alternative definition).
\func <*_idp {A : \Type} {a a' : A} (p : a = a') : p <* idp = p => {?}

-- | The two definitions of path concatenation are equivalent.
\func <*_*> {A : \Type} {a a' a'' : A} (p : a = a') (q : a' = a'') : p <* q = p *> q => {?}

-- | Inverse of a concatenated path.
\func *>_inv-comm {A : \Type} {a a' a'' : A} (p : a = a') (q : a' = a'') : inv (p *> q) = inv q *> inv p => {?}

-- | pmap commutes with inversion.
\func pmap_inv-comm {A B : \Type} {a a' : A} (f : A -> B) (p : a = a') : pmap f (inv p) = inv (pmap f p) => {?}

-- | Path concatenation is associative.
\func *>-assoc {A : \Type} {a1 a2 a3 a4 : A} (p : a1 = a2) (q : a2 = a3) (r : a3 = a4) : (p *> q) *> r = p *> (q *> r) => {?}

-- | Finisher for equational reasoning.
\func \fix 2 qed {A : \Type} (a : A) : a = a => {?}

-- | Concatenation operator for equational reasoning.
\func \infixr 1 >== {A : \Type} {a a' a'' : A} (p : a = a') (q : a' = a'') => {?}

-- | Initiator for equational reasoning.
\func \infix 2 ==< {A : \Type} (a : A) {a' : A} (p : a = a') => {?}

-- | Path over idp.
\func idpOver (A : I -> \Type) (a : A left) : Path A a (coe A a right) => {?}

-- | Path over a path.
\func pathOver {A : I -> \Type} {a : A left} {a' : A right} (p : coe A a right = a') : Path A a a' => {?}

-- | Relationship between coe and path concatenation.
\func coe_path {A : \Type} {a1 a2 a3 a4 : A} (p : a2 = a1) (q : a2 = a3) (r : a3 = a4)
  : coe (\lam i => p @ i = r @ i) q right = inv p *> q *> r => {?}
  \where
    -- | Alternative version of coe_path.
    \func alt {A : \Type} {a1 a2 a3 a4 : A} (p : a1 = a2) (q : a2 = a3) (r : a4 = a3)
      : coe (\lam i => p @ i = r @ i) (p *> q *> inv r) right = q => {?}

-- | Equality of paths is symmetric.
\func path-sym {A : \Type} (a a' : A) : (a = a') = (a' = a) => {?}

-- | Rotate path to the left.
\func rotatePathLeft {A : \Type} {a a' a'' : A} {p : a' = a} {q : a' = a''} {r : a = a''} (t : q = p *> r)
  : inv p *> q = r => {?}

-- | Homotopies are natural.
\func homotopy-isNatural {A B : \Type} (f g : A -> B) (h : \Pi (a : A) -> f a = g a) {a a' : A} (p : a = a')
  : pmap f p *> h a' = h a *> pmap g p => {?}

-- | Homotopy application commutes.
\func homotopy_app-comm {A : \Type} (f : A -> A) (h : \Pi (a : A) -> f a = a) (a : A) : h (f a) = pmap f (h a) => {?}

-- | Dependent pmap.
\func pmapd {A : \Type} {B : A -> \Type} (f : \Pi (x : A) -> B x) {a a' : A} (p : a = a')
  : transport B p (f a) = f a' => {?}

-- | Relationship between pmapd and pathOver.
\func pmapd_pathOver {A : \Type} (B : A -> \Type) (f : \Pi (x : A) -> B x) {a a' : A} (p : a = a') (s : transport B p (f a) = f a')
                     (t : path (\lam i => f (p @ i)) = {Path (\lam i => B (p @ i)) (f a) (f a')} pathOver s) : pmapd f p = s => {?}

-- | Transport commutes with path concatenation.
\func transport_*> {A : \Type} (B : A -> \Type) {a a' a'' : A} (p : a = a') (q : a' = a'') (x : B a)
  : transport B (p *> q) x = transport B q (transport B p x) => {?}

-- | Transport in a pi type.
\func transport_pi {A : \Type} (B C : A -> \Type) {a a' : A} (p : a = a') (f : B a -> C a) (x : B a')
  : transport (\lam y => B y -> C y) p f x = transport C p (f (transport B (inv p) x)) => {?}

-- | Transport in a pi type (functional version).
\func transport_pi2 {A : \Type} (B C : A -> \Type) {a a' : A} (p : a = a') (f : B a -> C a) (g : B a' -> C a') (t : \Pi (x : B a) -> transport C p (f x) = g (transport B p x))
  : transport (\lam y => B y -> C y) p f = g => {?}

-- | Transport in a dependent pi type.
\func transport_depPi {A B : \Type} (C : A -> B -> \Type) {a a' : A} (p : a = a') (f : \Pi (b : B) -> C a b) (x : B)
  : transport (\lam y => \Pi (b : B) -> C y b) p f x = transport (C __ x) p (f x) => {?}

-- | Transport in an equality type (right side).
\func transport_path-right {A : \Type} {a0 a b : A} (p : a = b) (q : a0 = a)
  : transport (a0 =) p q = q *> p => {?}

-- | Transport in an equality type (left side).
\func transport_path-left {A : \Type} {a0 a b : A} (p : a = b) (q : a = a0)
  : transport (`= a0) p q = inv p *> q => {?}

-- | Transport in an equality type between functions.
\func transport_path_pmap {A B : \Type} (f g : A -> B) {a a' : A} (p : a = a') (q : f a = g a) (s : f a' = g a') (h : q *> pmap g p = pmap f p *> s) : transport (\lam x => f x = g x) p q = s => {?}
  \where {
    -- | Conversion for transport_path_pmap.
    \func conv {A B : \Type} (f g : A -> B) {a a' : A} (p : a = a') (q : f a = g a) (s : f a' = g a') (h : transport (\lam x => f x = g x) p q = s) : q *> pmap g p = pmap f p *> s => {?}
  }

-- | Transport in an equality type (fixed left side).
\func transport_path_pmap-right {A B : \Type} (b : B) (g : A -> B) {a a' : A} (p : a = a') (q : b = g a) (s : b = g a') (h : q *> pmap g p = s) : transport (\lam x => b = g x) p q = s => {?}
  \where {
    -- | Conversion for transport_path_pmap-right.
    \func conv {A B : \Type} (b : B) (g : A -> B) {a a' : A} (p : a = a') (q : b = g a) (s : b = g a') (h : transport (\lam x => b = g x) p q = s) : q *> pmap g p = s => {?}
  }

-- | Transport along a path and its inverse is identity.
\func transport_inv_id {A : \Type} (B : A -> \Type) {a b : A} (p : a = b) (x : B a)
  : transport B (inv p) (transport B p x) = x => {?}

-- | Transport along inverse and then the path is identity.
\func transport_id_inv {A : \Type} (B : A -> \Type) {a b : A} (p : a = b) (x : B b)
  : transport B p (transport B (inv p) x) = x => {?}

-- | Transport rotation.
\func transport-rotate {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') {x : B a} {y : B a'} (t : transport B p x = y)
  : x = transport B (inv p) y => {?}

-- | Relationship between transport along inverse and a function.
\func transport_inv_func {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') (g : B a' -> B a) (gf : \Pi (x : B a) -> g (transport B p x) = x) (b : B a')
  : transport B (inv p) b = g b => {?}

-- | coe in a sigma type.
\func coe_sigma {A : I -> \Type} (B : \Pi (i : I) -> A i -> \Type) (p : \Sigma (a : A left) (B left a)) (j : I)
  : coe (\lam i => \Sigma (a : A i) (B i a)) p j = (coe A p.1 j, coe (\lam i => B i (coe A p.1 i)) p.2 j) => {?}

-- | coe in a pi type.
\func coe_pi {B C : I -> \Type} {f : B left -> C left}
  : coe (\lam i => B i -> C i) f right = \lam x => coe C (f (coe2 B right x left)) right => {?}
