\import Data.Bool (Bool, So, false, not, true)
\import Function.Meta
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta

-- | A data type representing decidability of a proposition.
\data Dec (E : \Prop)
  | yes E
  | no (Not E)
  \where {
    -- | Dec E is a proposition.
    \use \level levelProp {E : \Prop} : isProp (Dec E)
      => {?}

    -- | Recursion principle for Dec.
    \func rec {R : \Type} {E : \Prop} (y : E -> R) (n : Not E -> R) (d : Dec E) : R
      => {?}
  }

-- | Decidability can be proven for any proposition that is already negated.
\lemma negated-dec (E : \Prop) {P : NegatedProp} (f : Dec E -> P) : P
  => {?}

-- | Converts a Dec value to a Boolean.
\func decToBool {E : \Prop} (d : Dec E) : Bool => {?}

-- | A class for types that have a decidable property.
\class Decide (E : \Prop)
  | decide : Dec E

-- | Returns a Decide instance for a given Dec value.
\lemma dec_decide {E : \Prop} (d : Dec E) : Decide E
  => {?}

-- | If E holds, then its decidability proof is 'yes'.
\lemma dec_yes_reduce {E : \Prop} {d : Dec E} (e : E) : d = yes e
  => {?}

-- | If Not E holds, then its decidability proof is 'no'.
\lemma dec_no_reduce {E : \Prop} {d : Dec E} (q : Not E) : d = no q
  => {?}

-- | Disjunction of decidable propositions is decidable.
\lemma Dec_|| {A B : \Prop} (d : Dec A) (e : Dec B) : Dec (A || B)
  => {?}

-- | Sigma type of decidable propositions is decidable.
\func SigmaDecide {A : Decide} (B : A -> Decide) : Decide (\Sigma (a : A) (B a))
  => {?}

-- | Product of decidable propositions is decidable.
\instance ProductDecide (A B : Decide) : Decide => {?}

-- | Negation of a decidable proposition is decidable.
\lemma NotDec {P : \Prop} (d : Dec P) : Dec (Not P)
  => {?}

-- | Negation of a Decide instance.
\instance NotDecide (A : Decide) : Decide (Not A)
  => {?}

-- | A class for sets.
\class BaseSet (E : \Set)

-- | A class for subsets.
\class SubSet (S : BaseSet) (\classifying contains : S -> \Prop) {
  -- | The set of elements in the subset.
  \func ISet : BaseSet => {?}
}

-- | A class for decidable subsets.
\class DecSubSet \extends SubSet
  | isDec (x : S) : Dec (contains x)
  \where {
    -- | The maximal subset (contains all elements).
    \func max {S : BaseSet} : DecSubSet S => {?}
  }

-- | A set with a property that double negation of equality implies equality.
\class SeparatedSet \extends BaseSet
  | separatedEq {x y : E} : Not (Not (x = y)) -> x = y

-- | A set with a tight apartness relation.
\class Set# \extends SeparatedSet {
  -- | The apartness relation.
  | \infix 4 # : E -> E -> \Prop
  -- | Apartness is irreflexive.
  | #-irreflexive {x : E} : Not (x # x)
  -- | Apartness is symmetric.
  | #-symmetric {x y : E} : x # y -> y # x
  -- | Apartness comparison.
  | #-comparison (x y z : E) : x # z -> x # y || y # z
  -- | Tightness: Not (x # y) implies x = y.
  | tightness {x y : E} : Not (x # y) -> x = y
  | separatedEq {x} ~~x=y => {?}

  -- | Apartness implies inequality.
  \lemma apartNotEqual {x y : E} (x#y : x # y) : x /= y => {?}
}

-- | A set with a decidable equality relation.
\class DecSet \extends BaseSet, Set# {
  -- | Decides equality of two elements.
  \field decideEq (x y : E) : Dec (x = y)
  -- | Inequality implies apartness.
  | nonEqualApart {x y : E} : x /= y -> x # y
  -- | Equality as a Boolean function.
  | \infix 4 == : E -> E -> Bool
  | == x y => {?}

  \default # x y : \Prop => {?}
  \default nonEqualApart \as nonEqualApartImpl {x} {y} (p : x /= y) : x # y => {?}
  \default #-irreflexive {x} (x/=x : x # x) : Empty => {?}
  \default #-symmetric {x} {y} (x/=y : x # y) : y # x => {?}
  \default #-comparison x y z (x/=z : x # z) : x # y || y # z => {?}
  \default tightness {x} {y} (x//=y : Not (x # y)) : x = y => {?}
}

-- | Sigma type of DecSets is a DecSet.
\func SigmaDecSet {A : DecSet} (B : A -> DecSet) : DecSet (\Sigma (a : A) (B a)) => {?}

-- | Decidable subset of a DecSet is a DecSet.
\func SubDecSet {A : DecSet} {B : A -> \Prop} : DecSet (\Sigma (a : A) (B a)) => {?}

-- | Booleans form a DecSet.
\instance DecBool : DecSet => {?}
  \where {
    -- | Equality on Booleans is decidable.
    \func compare (a b : Bool) : Dec (a = b)
      => {?}
  }

-- | Product of two DecSets is a DecSet.
\instance ProductDecSet (A B : DecSet) : DecSet (\Sigma A B) => {?}

-- | Equality in a DecSet is a Decide instance.
\instance EqualityDecide (A : DecSet) (a a' : A) : Decide (a = a') => {?}

-- | Arrays of DecSets form a DecSet.
\instance ArrayDec (A : DecSet) (n : Nat) : DecSet (Array A n) => {?}
  \where {
    -- | Equality of arrays is decidable.
    \private \func aux {n : Nat} (l l' : Array A n) : Dec (l = l')
      => {?}
  }

-- | If two elements are equal, decideEq returns 'yes'.
\lemma decideEq=_reduce {A : DecSet} {x y : A} (p : x = y) : decideEq x y = yes p
  => {?}

-- | If two elements are not equal, decideEq returns 'no'.
\lemma decideEq/=_reduce {A : DecSet} {x y : A} (p : x /= y) : decideEq x y = no p
  => {?}

-- | If '==' returns true, then the elements are equal.
\lemma ==_= {A : DecSet} {a a' : A} (so : So (a == a')) : a = a'
  => {?}

-- | If '==' returns true, then the elements are equal (alternative name).
\lemma =-dec {A : DecSet} {a a' : A} {so : So (a == a')} : a = a'
  => {?}

-- | If '==' returns false, then the elements are not equal.
\lemma /=-dec {A : DecSet} {a a' : A} {so : So (not (a == a'))} : a /= a'
  => {?}

-- | A truncated data type for sets.
\truncated \data Trunc0 (A : \Type) : \Set
  | in0 A
  \where {
    -- | Maps a function over a truncated type.
    \func map {A B : \Type} (t : Trunc0 A) (f : A -> B) : Trunc0 B
      => {?}
  }
